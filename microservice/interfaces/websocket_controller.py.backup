"""
Controlador WebSocket - Capa de interfaces
"""
import json
import base64
import logging
from typing import Dict, Any
from fastapi import WebSocket, WebSocketDisconnect

from application.use_cases import AnalyzeAudioUseCase, GetAnalysisStatusUseCase, HealthCheckUseCase
from application.streaming_use_cases import StreamingAnalysisUseCase, StreamingHealthCheckUseCase
from infrastructure.websocket.notification_service import WebSocketNotificationService
import asyncio
import time

logger = logging.getLogger(__name__)

class WebSocketController:
        """Iniciar sesión de análisis en tiempo real"""
        try:
            import uuid
            import time
            
            session_id = str(uuid.uuid4())
            min_confidence = message.get("min_confidence", 0.3)  # Confianza más alta para tiempo real
            
            # Guardar sesión
            self.real_time_sessions[session_id] = {
                'websocket': websocket,
                'created_at': time.time(),
                'last_detection': time.time(),
                'detection_history': [],
                'min_confidence': min_confidence,
                'chunk_count': 0,
                'total_detections': 0
            }
            
            logger.info(f"Sesión de tiempo real iniciada: {session_id} (confianza: {min_confidence})")
            
            await websocket.send_text(json.dumps({
                "type": "real_time_session_started",
                "session_id": session_id,
                "min_confidence": min_confidence,
                "message": "Escucha en tiempo real iniciada - Envía chunks de audio cada 2 segundos"
            }))
            
        except Exception as e:
            logger.error(f"Error iniciando tiempo real: {e}")
            await self._send_error(websocket, f"Error iniciando tiempo real: {e}")
    
    async def _handle_send_real_time_audio(self, websocket: WebSocket, message: Dict[str, Any]):
        """Procesar chunk de audio en tiempo real con pipeline asíncrono"""
        try:
            # Validar campos requeridos
            if "session_id" not in message or "audio" not in message:
                await self._send_error(websocket, "Campos 'session_id' y 'audio' requeridos")
                return
            
            session_id = message["session_id"]
            timestamp = message.get("timestamp", int(time.time() * 1000))
            
            # Verificar que la sesión existe
            if session_id not in self.real_time_sessions:
                await self._send_error(websocket, f"Sesión no encontrada: {session_id}")
                return
            
            session = self.real_time_sessions[session_id]
            session['chunk_count'] += 1
            
            # Decodificar audio
            try:
                audio_base64 = message["audio"]
                audio_data = base64.b64decode(audio_base64)
            except Exception as e:
                await self._send_error(websocket, f"Error decodificando audio Base64: {e}")
                return
            
            # RESPUESTA INMEDIATA (sin esperar análisis)
            queue_size = len(self.analysis_tasks)
            await websocket.send_text(json.dumps({
                "type": "real_time_chunk_received",
                "session_id": session_id,
                "timestamp": timestamp,
                "chunk_number": session['chunk_count'],
                "queue_size": queue_size,
                "audio_size_bytes": len(audio_data),
                "message": "Chunk recibido, analizando en segundo plano..."
            }))
            
            # ANÁLISIS EN BACKGROUND (no await)
            analysis_task = asyncio.create_task(
                self._process_real_time_audio_async(session_id, audio_data, timestamp, websocket)
            )
            self.analysis_tasks[timestamp] = analysis_task
            
            logger.debug(f"Chunk {session['chunk_count']} de sesión {session_id} en cola para análisis")
            
        except Exception as e:
            logger.error(f"Error procesando audio tiempo real: {e}")
            await self._send_error(websocket, f"Error procesando audio: {e}")
    
    async def _process_real_time_audio_async(self, session_id: str, audio_data: bytes, 
                                           timestamp: int, websocket: WebSocket):
        """Procesar audio en background y notificar cuando termine"""
        try:
            import time
            start_time = time.time()
            
            # REUTILIZAR tu código actual de análisis
            analysis = await self.analyze_audio_use_case.execute(
                audio_data, 
                f"real_time_{timestamp}.wav"
            )
            
            processing_time = time.time() - start_time
            session = self.real_time_sessions.get(session_id)
            
            if not session:
                logger.warning(f"Sesión {session_id} no existe al completar análisis")
                return
            
            # Filtrar por confianza de la sesión
            min_confidence = session['min_confidence']
            filtered_detections = [
                d for d in analysis.detections 
                if d.confidence >= min_confidence
            ]
            
            # Filtrar detecciones recientes para evitar duplicados
            new_detections = self._filter_recent_detections(
                filtered_detections, 
                session['detection_history']
            )
            
            # Actualizar estadísticas de sesión
            session['total_detections'] += len(new_detections)
            session['last_detection'] = time.time()
            
            # Enviar resultado cuando termine
            if new_detections:
                await websocket.send_text(json.dumps({
                    "type": "real_time_detections",
                    "session_id": session_id,
                    "analysis_timestamp": timestamp,
                    "processing_time_seconds": round(processing_time, 2),
                    "total_detections_found": len(analysis.detections),
                    "filtered_by_confidence": len(filtered_detections),
                    "new_detections": len(new_detections),
                    "birds": [
                        {
                            "species_name": d.species_name,
                            "species_code": d.species_code,
                            "confidence": round(d.confidence, 3),
                            "start_time": round(d.start_time, 1),
                            "end_time": round(d.end_time, 1),
                            "detected_at": timestamp,
                            "is_new": True
                        } for d in new_detections
                    ]
                }))
                
                # Guardar en historial
                session['detection_history'].extend(new_detections)
                
                logger.info(f"Sesión {session_id}: {len(new_detections)} nuevas detecciones "
                          f"(procesamiento: {processing_time:.2f}s)")
            else:
                # Enviar confirmación aunque no haya detecciones
                await websocket.send_text(json.dumps({
                    "type": "real_time_analysis_completed",
                    "session_id": session_id,
                    "analysis_timestamp": timestamp,
                    "processing_time_seconds": round(processing_time, 2),
                    "total_detections_found": len(analysis.detections),
                    "message": f"Sin nuevas detecciones (confianza < {min_confidence})"
                }))
                
        except Exception as e:
            logger.error(f"Error en análisis asíncrono sesión {session_id}: {e}")
            try:
                await websocket.send_text(json.dumps({
                    "type": "real_time_analysis_error",
                    "session_id": session_id,
                    "timestamp": timestamp,
                    "error": str(e)
                }))
            except:
                logger.error(f"No se pudo notificar error de análisis a sesión {session_id}")
                
        finally:
            # Limpiar task completada
            self.analysis_tasks.pop(timestamp, None)
    
    async def _handle_stop_real_time_listening(self, websocket: WebSocket, message: Dict[str, Any]):
        """Finalizar sesión de tiempo real"""
        try:
            session_id = message.get("session_id")
            
            if session_id and session_id in self.real_time_sessions:
                session = self.real_time_sessions[session_id]
                
                # Cancelar tasks pendientes para esta sesión
                pending_tasks = [
                    task for timestamp, task in self.analysis_tasks.items()
                    if not task.done()
                ]
                
                for task in pending_tasks:
                    task.cancel()
                
                # Estadísticas finales
                duration = time.time() - session['created_at']
                
                # Eliminar sesión
                del self.real_time_sessions[session_id]
                
                await websocket.send_text(json.dumps({
                    "type": "real_time_session_ended",
                    "session_id": session_id,
                    "session_stats": {
                        "duration_seconds": round(duration, 1),
                        "total_chunks_processed": session['chunk_count'],
                        "total_detections": session['total_detections'],
                        "pending_tasks_cancelled": len(pending_tasks)
                    },
                    "message": "Sesión de tiempo real finalizada"
                }))
                
                logger.info(f"Sesión tiempo real {session_id} finalizada: "
                          f"{session['chunk_count']} chunks, {session['total_detections']} detecciones")
            else:
                await self._send_error(websocket, f"Sesión no encontrada: {session_id}")
        
        except Exception as e:
            logger.error(f"Error finalizando tiempo real: {e}")
            await self._send_error(websocket, f"Error finalizando tiempo real: {e}")
    
    def _filter_recent_detections(self, new_detections, history, time_window=10.0):
        """Filtrar detecciones que ya aparecieron recientemente"""
        import time
        
        current_time = time.time()
        filtered = []
        
        for detection in new_detections:
            # Verificar si esta especie ya fue detectada recientemente
            is_recent = any(
                h.species_code == detection.species_code and 
                (current_time - getattr(h, 'detected_at', 0)) < time_window
                for h in history[-20:]  # Solo revisar últimas 20 detecciones
            )
            
            if not is_recent:
                # Agregar timestamp de detección
                detection.detected_at = current_time
                filtered.append(detection)
        
        return filtered
    
    async def _send_error(self, websocket: WebSocket, error_message: str):
        """Enviar mensaje de error"""
        try:
            await websocket.send_text(json.dumps({
                "type": "error",
                "error": error_message
            }))
        except Exception as e:
            logger.error(f"Error enviando mensaje de error: {e}")AnalysisUseCase, StreamingHealthCheckUseCase
from infrastructure.websocket.notification_service import WebSocketNotificationService

logger = logging.getLogger(__name__)

class WebSocketController:
    """Controlador para manejar conexiones WebSocket"""
    
    def __init__(
        self,
        analyze_audio_use_case: AnalyzeAudioUseCase,
        get_analysis_status_use_case: GetAnalysisStatusUseCase,
        health_check_use_case: HealthCheckUseCase,
        streaming_analysis_use_case: StreamingAnalysisUseCase,
        streaming_health_check_use_case: StreamingHealthCheckUseCase,
        notification_service: WebSocketNotificationService
    ):
        self.analyze_audio_use_case = analyze_audio_use_case
        self.get_analysis_status_use_case = get_analysis_status_use_case
        self.health_check_use_case = health_check_use_case
        self.streaming_analysis_use_case = streaming_analysis_use_case
        self.streaming_health_check_use_case = streaming_health_check_use_case
        self.notification_service = notification_service
        
        # NUEVO: Storage para sesiones de tiempo real
        self.real_time_sessions = {}  # session_id -> session_data
        self.analysis_tasks = {}      # timestamp -> asyncio.Task
    
    async def handle_connection(self, websocket: WebSocket):
        """Manejar conexión WebSocket"""
        await websocket.accept()
        
        # Registrar conexión para notificaciones generales
        self.notification_service.register_connection(websocket)
        
        try:
            # Enviar mensaje de bienvenida
            await websocket.send_text(json.dumps({
                "type": "connected",
                "message": "Conectado al servicio de análisis de aves",
                "available_commands": [
                    "analyze_audio",
                    "get_analysis_status", 
                    "health_check",
                    "start_streaming",
                    "stream_audio_chunk",
                    "end_streaming",
                    "get_streaming_status",
                    "streaming_health_check",
                    "start_real_time_listening",
                    "send_real_time_audio",
                    "stop_real_time_listening"
                ]
            }))
            
            while True:
                # Recibir mensaje
                data = await websocket.receive_text()
                message = json.loads(data)
                
                # Procesar mensaje según tipo
                await self._handle_message(websocket, message)
                
        except WebSocketDisconnect:
            logger.info("Cliente desconectado")
        except Exception as e:
            logger.error(f"Error en conexión WebSocket: {e}")
            await self._send_error(websocket, str(e))
        finally:
            # Desregistrar conexión
            self.notification_service.unregister_connection(websocket)
    
    async def _handle_message(self, websocket: WebSocket, message: Dict[str, Any]):
        """Procesar mensaje recibido"""
        message_type = message.get("type")
        
        if message_type == "analyze_audio":
            await self._handle_analyze_audio(websocket, message)
        elif message_type == "get_analysis_status":
            await self._handle_get_analysis_status(websocket, message)
        elif message_type == "health_check":
            await self._handle_health_check(websocket)
        elif message_type == "start_streaming":
            await self._handle_start_streaming(websocket)
        elif message_type == "stream_audio_chunk":
            await self._handle_stream_audio_chunk(websocket, message)
        elif message_type == "end_streaming":
            await self._handle_end_streaming(websocket, message)
        elif message_type == "get_streaming_status":
            await self._handle_get_streaming_status(websocket, message)
        elif message_type == "streaming_health_check":
            await self._handle_streaming_health_check(websocket)
        elif message_type == "start_real_time_listening":
            await self._handle_start_real_time_listening(websocket, message)
        elif message_type == "send_real_time_audio":
            await self._handle_send_real_time_audio(websocket, message)
        elif message_type == "stop_real_time_listening":
            await self._handle_stop_real_time_listening(websocket, message)
        else:
            await self._send_error(websocket, f"Tipo de mensaje no reconocido: {message_type}")
    
    async def _handle_analyze_audio(self, websocket: WebSocket, message: Dict[str, Any]):
        """Manejar solicitud de análisis de audio"""
        try:
            # Validar campos requeridos
            if "audio" not in message:
                await self._send_error(websocket, "Campo 'audio' requerido")
                return
            
            # Extraer datos
            audio_base64 = message["audio"]
            filename = message.get("filename", "audio.mp3")
            
            # Decodificar audio
            try:
                audio_data = base64.b64decode(audio_base64)
            except Exception as e:
                await self._send_error(websocket, f"Error decodificando audio Base64: {e}")
                return
            
            # Validar tamaño
            if len(audio_data) > 50 * 1024 * 1024:  # 50MB
                await self._send_error(websocket, "Archivo demasiado grande (máximo 50MB)")
                return
            
            # Ejecutar análisis
            analysis = await self.analyze_audio_use_case.execute(audio_data, filename)
            
            # El resultado se enviará automáticamente via notificaciones
            # Pero enviamos confirmación inmediata
            await websocket.send_text(json.dumps({
                "type": "analysis_accepted",
                "analysis_id": analysis.analysis_id,
                "message": "Análisis iniciado correctamente"
            }))
            
        except Exception as e:
            logger.error(f"Error procesando análisis: {e}")
            await self._send_error(websocket, f"Error procesando análisis: {e}")
    
    async def _handle_get_analysis_status(self, websocket: WebSocket, message: Dict[str, Any]):
        """Manejar solicitud de estado de análisis"""
        try:
            analysis_id = message.get("analysis_id")
            if not analysis_id:
                await self._send_error(websocket, "Campo 'analysis_id' requerido")
                return
            
            analysis = await self.get_analysis_status_use_case.execute(analysis_id)
            
            if analysis:
                await websocket.send_text(json.dumps({
                    "type": "analysis_status",
                    "analysis": analysis.to_dict()
                }))
            else:
                await websocket.send_text(json.dumps({
                    "type": "analysis_not_found",
                    "analysis_id": analysis_id,
                    "message": "Análisis no encontrado"
                }))
                
        except Exception as e:
            logger.error(f"Error obteniendo estado: {e}")
            await self._send_error(websocket, f"Error obteniendo estado: {e}")
    
    async def _handle_health_check(self, websocket: WebSocket):
        """Manejar verificación de salud"""
        try:
            health = await self.health_check_use_case.execute()
            
            await websocket.send_text(json.dumps({
                "type": "health_check",
                "health": health
            }))
            
        except Exception as e:
            logger.error(f"Error en health check: {e}")
            await self._send_error(websocket, f"Error en health check: {e}")
    
    async def _handle_start_streaming(self, websocket: WebSocket):
        """Manejar inicio de sesión de streaming"""
        try:
            session_id = await self.streaming_analysis_use_case.start_session()
            
            # Registrar conexión para esta sesión
            self.notification_service.register_connection(websocket, session_id=session_id)
            
            await websocket.send_text(json.dumps({
                "type": "streaming_started",
                "session_id": session_id,
                "message": "Sesión de streaming iniciada"
            }))
            
        except Exception as e:
            logger.error(f"Error iniciando streaming: {e}")
            await self._send_error(websocket, f"Error iniciando streaming: {e}")
    
    async def _handle_stream_audio_chunk(self, websocket: WebSocket, message: Dict[str, Any]):
        """Manejar chunk de audio en streaming"""
        try:
            # Validar campos requeridos
            required_fields = ["session_id", "audio", "timestamp", "duration", "sequence"]
            for field in required_fields:
                if field not in message:
                    await self._send_error(websocket, f"Campo '{field}' requerido")
                    return
            
            session_id = message["session_id"]
            audio_base64 = message["audio"]
            timestamp = float(message["timestamp"])
            duration = float(message["duration"])
            sequence = int(message["sequence"])
            
            # Decodificar audio
            try:
                audio_data = base64.b64decode(audio_base64)
            except Exception as e:
                await self._send_error(websocket, f"Error decodificando audio Base64: {e}")
                return
            
            # Procesar chunk
            detections = await self.streaming_analysis_use_case.process_audio_chunk(
                session_id, audio_data, timestamp, duration, sequence
            )
            
            # Enviar confirmación del chunk
            await websocket.send_text(json.dumps({
                "type": "chunk_processed",
                "session_id": session_id,
                "sequence": sequence,
                "detections_count": len(detections)
            }))
            
            # Enviar detecciones si las hay
            for detection in detections:
                await self.notification_service.notify_real_time_detection(detection)
            
        except Exception as e:
            logger.error(f"Error procesando chunk de audio: {e}")
            await self._send_error(websocket, f"Error procesando chunk: {e}")
    
    async def _handle_end_streaming(self, websocket: WebSocket, message: Dict[str, Any]):
        """Manejar fin de sesión de streaming"""
        try:
            session_id = message.get("session_id")
            if not session_id:
                await self._send_error(websocket, "Campo 'session_id' requerido")
                return
            
            summary = await self.streaming_analysis_use_case.end_session(session_id)
            
            if summary:
                await websocket.send_text(json.dumps({
                    "type": "streaming_ended",
                    "session_summary": summary
                }))
            else:
                await self._send_error(websocket, f"Sesión no encontrada: {session_id}")
            
            # Desregistrar conexión
            self.notification_service.unregister_connection(websocket, session_id=session_id)
            
        except Exception as e:
            logger.error(f"Error finalizando streaming: {e}")
            await self._send_error(websocket, f"Error finalizando streaming: {e}")
    
    async def _handle_get_streaming_status(self, websocket: WebSocket, message: Dict[str, Any]):
        """Manejar solicitud de estado de streaming"""
        try:
            session_id = message.get("session_id")
            if not session_id:
                await self._send_error(websocket, "Campo 'session_id' requerido")
                return
            
            status = await self.streaming_analysis_use_case.get_session_status(session_id)
            
            if status:
                await websocket.send_text(json.dumps({
                    "type": "streaming_status",
                    "status": status
                }))
            else:
                await websocket.send_text(json.dumps({
                    "type": "streaming_not_found",
                    "session_id": session_id,
                    "message": "Sesión de streaming no encontrada"
                }))
                
        except Exception as e:
            logger.error(f"Error obteniendo estado de streaming: {e}")
            await self._send_error(websocket, f"Error obteniendo estado de streaming: {e}")
    
    async def _handle_streaming_health_check(self, websocket: WebSocket):
        """Manejar health check del servicio de streaming"""
        try:
            health = await self.streaming_health_check_use_case.execute()
            
            await websocket.send_text(json.dumps({
                "type": "streaming_health_check",
                "health": health
            }))
            
        except Exception as e:
            logger.error(f"Error en streaming health check: {e}")
            await self._send_error(websocket, f"Error en streaming health check: {e}")
    
    async def _send_error(self, websocket: WebSocket, error_message: str):
        """Enviar mensaje de error"""
        try:
            await websocket.send_text(json.dumps({
                "type": "error",
                "message": error_message
            }))
        except Exception as e:
            logger.error(f"Error enviando mensaje de error: {e}")